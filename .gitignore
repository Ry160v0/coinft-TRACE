# Large raw/processed calibration data (h5, csv, video captures, etc.)
# Keep the empty data/ folder itself tracked (see data/.gitkeep) so it exists on clone.
data/*
!data/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
env/

# Editor / OS
.vscode/
.DS_Store

# PlatformIO build artifacts (Teensy firmware)
hardware_files/Teensy/.pio/
hardware_files/Teensy/.vscode/
